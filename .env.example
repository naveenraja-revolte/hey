NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticket_allocator?sslmode=disable
REDIS_URL=redis://localhost:6379
ALLOCATION_STRATEGY=sla-aware-priority
ALLOCATION_BATCH_SIZE=100
ESCALATION_WINDOW_MINUTES=5
SLA_PRIORITY_WEIGHT=5
SLA_URGENCY_WEIGHT=10
SLA_AGING_WEIGHT=2
SLA_URGENCY_HORIZON_MINUTES=60
SLA_AGING_HORIZON_MINUTES=240
SKILL_LOAD_PENALTY=1

{
  "name": "smart-ticket-allocation-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "npm run db:generate && vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run db:generate && RUN_INTEGRATION=1 vitest run tests/service.integration.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run db:generate && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.7.3",
    "dotenv": "18.0.10",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
